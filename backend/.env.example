# ─── Database ───────────────────────────────────────────────
# Connection string for the PostgreSQL instance.
# The port (5444) matches the docker-compose.dev.yml mapping.
DATABASE_URL=postgresql://postgres:postgres@localhost:5444/urlshortener

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Server ─────────────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# ─── Snowflake ID ───────────────────────────────────────────
# Must be unique per server instance in a multi-node deployment.
# Each node needs a different INSTANCE_ID to avoid ID collisions.
INSTANCE_ID=1
